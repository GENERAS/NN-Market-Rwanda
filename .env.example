# GEMINI_API_KEY: Required for Gemini AI API calls if used.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for canonical URLs, sitemaps, and Open Graph metadata.
APP_URL="MY_APP_URL"

# Optional server-side admin passcode override (if unset, default/configured admin credentials apply)
ADMIN_PASSCODE=

# Set LOCK_ADMIN=true when going live to enforce password-only admin sign-in and login rate limiting
LOCK_ADMIN=false

# Optional default referral URL for N-Nutrition registration (also configurable in Admin Settings)
N_NUTRITION_REFERRAL_URL=

# Optional default private agent contact details (also configurable in Admin Settings; never exposed publicly before request submission)
AGENT_WHATSAPP_NUMBER=
AGENT_PHONE_NUMBER=
